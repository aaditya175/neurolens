# NeuroLens Environment Configuration

# General Environment
ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-super-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML Execution
FAKE_MODEL=true
DEVICE=cpu

# Database
POSTGRES_USER=neurolens
POSTGRES_PASSWORD=neurolens_dev_secret
POSTGRES_DB=neurolens_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://neurolens:neurolens_dev_secret@localhost:5432/neurolens_db

# Async Worker & Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=/data
MAX_UPLOAD_SIZE_MB=500

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
